{%- comment -%}
  Placeholder image snippet.
  Renders a labeled image placeholder when no real image is available, OR
  the actual image (with responsive srcset) when one is provided.

  Inputs:
    image:           Image object (optional). If present, renders the image.
    alt:             string (alt text)
    ratio:           '4-5' | '1-1' | '3-4' | '16-9' | '21-9'   (default: 4-5)
    tone:            'tone-deep' | 'tone-sage' | 'tone-seaglass' | 'tone-warm' | 'tone-bone'
    caption:         placeholder caption text (used when no image)
    corner:          small corner tag (used when no image)
    sizes:           sizes attr for responsive image (default: '100vw')
    widths:          widths comma-list for srcset (default: '480, 720, 960, 1200, 1600, 2000')
    class:           extra classes
{%- endcomment -%}

{%- liquid
  assign ratio = ratio | default: '4-5'
  assign tone = tone | default: 'tone-deep'
  assign sizes = sizes | default: '100vw'
  assign widths = widths | default: '480, 720, 960, 1200, 1600, 2000'
  assign extra_class = class | default: ''
-%}

<div class="ph ratio-{{ ratio }} {{ tone }} {{ extra_class }}">
  {%- if image != blank -%}
    {{ image | image_url: width: 2000 | image_tag:
        loading: 'lazy',
        sizes: sizes,
        widths: widths,
        alt: alt
    }}
  {%- else -%}
    <span class="ph-caption">{{ caption | default: 'IMAGE · description' }}</span>
    {% if corner != blank %}
      <span class="ph-corner">{{ corner }}</span>
    {% endif %}
  {%- endif -%}
</div>
