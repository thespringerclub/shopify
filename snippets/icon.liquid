{%- comment -%}
  Centralized SVG icon set. Brief §10: hairline 1.25px Soft Ink, no fill, square corners.
  Usage: {%- render 'icon', icon: 'search', size: 20 -%}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 20
-%}

{%- case icon -%}
  {%- when 'search' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <circle cx="9" cy="9" r="6"/>
      <line x1="13.5" y1="13.5" x2="17.5" y2="17.5" stroke-linecap="square"/>
    </svg>

  {%- when 'account' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <circle cx="10" cy="7" r="3.5"/>
      <path d="M3 17 C3 13.5, 6 11.5, 10 11.5 C14 11.5, 17 13.5, 17 17"/>
    </svg>

  {%- when 'bag' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <path d="M3.5 6 L16.5 6 L15.5 17.5 L4.5 17.5 Z"/>
      <path d="M7 6 V4.5 C7 3, 8 2, 10 2 C12 2, 13 3, 13 4.5 V6"/>
    </svg>

  {%- when 'close' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="4" y1="4" x2="16" y2="16" stroke-linecap="square"/>
      <line x1="16" y1="4" x2="4" y2="16" stroke-linecap="square"/>
    </svg>

  {%- when 'arrow-right' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="2" y1="8" x2="13" y2="8" stroke-linecap="square"/>
      <polyline points="9,4 13,8 9,12"/>
    </svg>

  {%- when 'arrow-left' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="14" y1="8" x2="3" y2="8" stroke-linecap="square"/>
      <polyline points="7,4 3,8 7,12"/>
    </svg>

  {%- when 'plus' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="7" y1="2" x2="7" y2="12" stroke-linecap="square"/>
      <line x1="2" y1="7" x2="12" y2="7" stroke-linecap="square"/>
    </svg>

  {%- when 'minus' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="2" y1="7" x2="12" y2="7" stroke-linecap="square"/>
    </svg>

  {%- when 'menu' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="3" y1="6"  x2="17" y2="6"  stroke-linecap="square"/>
      <line x1="3" y1="14" x2="17" y2="14" stroke-linecap="square"/>
    </svg>

  {%- when 'filter' -%}
    <svg width="{{ size }}" height="{{ size }}" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
      <line x1="3" y1="5" x2="17" y2="5"/>
      <line x1="3" y1="10" x2="13" y2="10"/>
      <line x1="3" y1="15" x2="9" y2="15"/>
    </svg>
{%- endcase -%}
