{%- comment -%}
  Theme block — Button. Brief §12.
  Soft Ink primary, Bone-with-Soft-Ink-border secondary, Soft Ink hairline-underline tertiary link.
{%- endcomment -%}

{%- liquid
  case block.settings.style
    when 'primary'
      assign cls = 'btn-primary'
    when 'secondary'
      assign cls = 'btn-secondary'
    when 'link'
      assign cls = 'link'
    when 'link-italic'
      assign cls = 'link-italic'
  endcase
  assign href = block.settings.link | default: '#'
-%}

<div
  style="
    {% if block.settings.align %}text-align: {{ block.settings.align }};{% endif %}
    {% if block.settings.margin_top != blank %}margin-top: {{ block.settings.margin_top }}px;{% endif %}
    {% if block.settings.margin_bottom != blank %}margin-bottom: {{ block.settings.margin_bottom }}px;{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <a class="{{ cls }}" href="{{ href }}">{{ block.settings.label }}</a>
</div>

{% schema %}
{
  "name": "Button",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "The collection" },
    { "type": "url",  "id": "link",  "label": "Link" },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "default": "link",
      "info": "Use Primary sparingly. Brief §15: heritage brands do not animate.",
      "options": [
        { "value": "primary",     "label": "Primary (Soft Ink fill)" },
        { "value": "secondary",   "label": "Secondary (Bone with border)" },
        { "value": "link",        "label": "Tertiary link (hairline)" },
        { "value": "link-italic", "label": "Tertiary link, italic" }
      ]
    },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "left",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ]
    },
    { "type": "range", "id": "margin_top",    "label": "Margin top (px)",    "min": 0, "max": 80, "step": 2, "default": 24 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom (px)", "min": 0, "max": 80, "step": 2, "default": 0 }
  ],
  "presets": [
    { "name": "Button" }
  ]
}
{% endschema %}
