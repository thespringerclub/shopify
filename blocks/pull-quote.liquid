{%- comment -%}
  Theme block — Pull quote.
  Cormorant italic, larger size, hairline rules above and below. Brief §11.10.
{%- endcomment -%}

<div
  class="pull-rule"
  style="
    {% if block.settings.margin_top != blank %}margin-top: {{ block.settings.margin_top }}px;{% endif %}
    {% if block.settings.margin_bottom != blank %}margin-bottom: {{ block.settings.margin_bottom }}px;{% endif %}
  "
  {{ block.shopify_attributes }}
>
  <p class="pull-quote" style="font-size: {{ block.settings.size_em }}em;">
    &ldquo;{{ block.settings.text }}&rdquo;
  </p>
  {% if block.settings.attribution != blank %}
    <p class="micro" style="text-align: center; color: var(--ink-60); margin-top: 16px;">
      — {{ block.settings.attribution }}
    </p>
  {% endif %}
</div>

{% schema %}
{
  "name": "Pull quote",
  "settings": [
    { "type": "text",  "id": "text",        "label": "Quote", "default": "Bred to flush. Built to last." },
    { "type": "text",  "id": "attribution", "label": "Attribution (optional)" },
    { "type": "range", "id": "size_em",       "label": "Size (em)", "min": 1.2, "max": 2.5, "step": 0.1, "default": 1.7 },
    { "type": "range", "id": "margin_top",    "label": "Margin top (px)",    "min": 0, "max": 96, "step": 4, "default": 48 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom (px)", "min": 0, "max": 96, "step": 4, "default": 48 }
  ],
  "presets": [
    { "name": "Pull quote" }
  ]
}
{% endschema %}
