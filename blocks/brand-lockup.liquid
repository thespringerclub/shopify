{%- comment -%}
  Theme block — Brand lockup.
  Renders the horizontal or stacked lockup. Falls back to a labeled placeholder
  if the logomark image isn't uploaded in theme settings.
  Brief §8.
{%- endcomment -%}

<div
  style="
    {% if block.settings.align %}text-align: {{ block.settings.align }};{% endif %}
    {% if block.settings.margin_top != blank %}margin-top: {{ block.settings.margin_top }}px;{% endif %}
    {% if block.settings.margin_bottom != blank %}margin-bottom: {{ block.settings.margin_bottom }}px;{% endif %}
    display: flex; justify-content: {% if block.settings.align == 'left' %}flex-start{% elsif block.settings.align == 'right' %}flex-end{% else %}center{% endif %};
  "
  {{ block.shopify_attributes }}
>
  {%- render 'brand-lockup',
        variant: block.settings.variant,
        color: block.settings.color,
        scale: block.settings.scale
  -%}
</div>

{% schema %}
{
  "name": "Brand lockup",
  "settings": [
    {
      "type": "select",
      "id": "variant",
      "label": "Variant",
      "default": "stacked",
      "info": "Brief §8.",
      "options": [
        { "value": "stacked",    "label": "Stacked (logomark over wordmark)" },
        { "value": "horizontal", "label": "Horizontal (logomark + wordmark)" },
        { "value": "logomark",   "label": "Logomark alone" },
        { "value": "wordmark",   "label": "Wordmark alone" }
      ]
    },
    {
      "type": "select",
      "id": "color",
      "label": "Color",
      "default": "ink",
      "options": [
        { "value": "ink",  "label": "Soft Ink (on light grounds)" },
        { "value": "bone", "label": "Bone (on dark / hero grounds)" }
      ]
    },
    { "type": "range", "id": "scale", "label": "Scale", "min": 0.5, "max": 2, "step": 0.1, "default": 1 },
    {
      "type": "select",
      "id": "align",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right" }
      ]
    },
    { "type": "range", "id": "margin_top",    "label": "Margin top (px)",    "min": 0, "max": 120, "step": 4, "default": 0 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom (px)", "min": 0, "max": 120, "step": 4, "default": 24 }
  ],
  "presets": [
    { "name": "Brand lockup" }
  ]
}
{% endschema %}
