{%- comment -%}
  Customer registration. Brief §11.8 — "Join the rolls."
{%- endcomment -%}

<section style="padding: 120px 0;">
  <div class="container-narrow" style="max-width: 480px;">
    <p class="eyebrow text-muted text-center" style="margin-bottom: 16px;">{{ section.settings.eyebrow | default: 'Account' }}</p>
    <h1 class="h1-page serif-italic text-center" style="margin-bottom: 16px;">{{ section.settings.heading | default: 'Join the rolls.' }}</h1>
    <p class="serif-italic text-center" style="font-size: 1.0625rem; color: var(--ink-60); margin-bottom: 48px;">
      {{ section.settings.subtitle | default: 'Three fields. A short formality.' }}
    </p>

    {%- form 'create_customer', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="field-error" style="margin-bottom: 24px; text-align: center;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
          <div>
            <label class="label" for="reg_first">{{ 'customer.first_name' | t }}</label>
            <input class="input" type="text" name="customer[first_name]" id="reg_first" autocomplete="given-name" required>
          </div>
          <div>
            <label class="label" for="reg_last">{{ 'customer.last_name' | t }}</label>
            <input class="input" type="text" name="customer[last_name]" id="reg_last" autocomplete="family-name" required>
          </div>
        </div>
        <div>
          <label class="label" for="reg_email">{{ 'customer.email' | t }}</label>
          <input class="input" type="email" name="customer[email]" id="reg_email" autocomplete="email" required>
        </div>
        <div>
          <label class="label" for="reg_password">{{ 'customer.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="reg_password" autocomplete="new-password" required>
        </div>
        <button class="btn-primary" type="submit" style="margin-top: 12px;">{{ 'customer.register' | t }}</button>
        <p class="serif-italic text-center" style="font-size: 0.9375rem; color: var(--ink-60); margin-top: 8px;">
          Already on the rolls? <a href="{{ routes.account_login_url }}" class="link-italic">{{ 'customer.sign_in' | t }}</a>
        </p>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Customer register",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow",  "label": "Eyebrow",  "default": "Account" },
    { "type": "text", "id": "heading",  "label": "Heading",  "default": "Join the rolls." },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Three fields. A short formality." }
  ]
}
{% endschema %}
