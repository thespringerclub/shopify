{%- comment -%}
  Featured products — three editorial product moments. Brief §11.3.
  Each block is one product with optional eyebrow / placeholder caption.
{%- endcomment -%}

{%- liquid
  assign columns = section.settings.columns | default: 3
-%}

<section
  class="featured-products"
  style="
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: var(--bone);
  "
>
  <div class="container-wide">
    {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
      <div style="text-align: {{ section.settings.heading_align }}; margin-bottom: 48px;">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow text-muted" style="margin-bottom: 18px;">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="h2-italic">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div style="display: grid; grid-template-columns: repeat({{ columns }}, 1fr); gap: 32px;" class="featured-grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'product' -%}
            {%- assign p = all_products[block.settings.product] -%}
            <div class="featured-tile" {{ block.shopify_attributes }}>
              {%- if p != blank -%}
                <a class="product-tile" href="{{ p.url }}">
                  <div class="ph ratio-4-5 {% if p.featured_media == blank %}{{ block.settings.tone }}{% endif %}">
                    {%- if p.featured_media != blank -%}
                      {{ p.featured_media | image_url: width: 1200 | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 1025px) 33vw, 100vw',
                          widths: '480, 720, 960, 1200, 1600',
                          alt: p.featured_media.alt | default: p.title
                      }}
                    {%- else -%}
                      <span class="ph-caption">{{ block.settings.placeholder_caption | default: p.title | upcase }}</span>
                    {%- endif -%}
                  </div>
                  <div style="padding: 0 4px; margin-top: 14px;">
                    {% if block.settings.eyebrow != blank %}
                      <p class="eyebrow text-muted" style="margin-bottom: 6px;">{{ block.settings.eyebrow }}</p>
                    {% endif %}
                    <h3 class="serif-italic" style="font-size: 1.5rem; margin: 0;">{{ p.title }}.</h3>
                    <p class="small text-muted" style="margin-top: 8px;">{{ p.price | money_without_trailing_zeros }}</p>
                  </div>
                </a>
              {%- else -%}
                {%- comment -%} Placeholder when no product is configured (in theme editor) {%- endcomment -%}
                <div class="product-tile">
                  <div class="ph ratio-4-5 {{ block.settings.tone }}">
                    <span class="ph-caption">{{ block.settings.placeholder_caption | default: 'PRODUCT · description' }}</span>
                  </div>
                  <div style="padding: 0 4px; margin-top: 14px;">
                    {% if block.settings.eyebrow != blank %}
                      <p class="eyebrow text-muted" style="margin-bottom: 6px;">{{ block.settings.eyebrow }}</p>
                    {% endif %}
                    <h3 class="serif-italic" style="font-size: 1.5rem; margin: 0;">{{ block.settings.fallback_title | default: 'A featured product.' }}</h3>
                    <p class="small text-muted" style="margin-top: 8px;">{{ block.settings.fallback_price | default: '—' }}</p>
                  </div>
                </div>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .featured-grid { grid-template-columns: 1fr !important; gap: 48px !important; }
  }
</style>

{% schema %}
{
  "name": "Featured products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "" },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "3",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ]
    },
    { "type": "range", "id": "padding_top",    "label": "Padding top (px)",    "min": 0, "max": 200, "step": 8, "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom (px)", "min": 0, "max": 200, "step": 8, "default": 96 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Featured product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Apparel · Tees" },
        {
          "type": "select",
          "id": "tone",
          "label": "Placeholder tone",
          "default": "tone-sage",
          "options": [
            { "value": "tone-sage",     "label": "Sage" },
            { "value": "tone-seaglass", "label": "Sea Glass" },
            { "value": "tone-warm",     "label": "Warm" },
            { "value": "tone-deep",     "label": "Deep" }
          ]
        },
        { "type": "text", "id": "placeholder_caption", "label": "Placeholder caption", "default": "ON-FIGURE · believable setting, soft diffused light" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title (no product)", "default": "A featured product." },
        { "type": "text", "id": "fallback_price", "label": "Fallback price (no product)", "default": "—" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Featured products",
      "blocks": [
        { "type": "product", "settings": { "eyebrow": "Apparel · Tees", "tone": "tone-sage", "placeholder_caption": "SPRINGER MUM · on-figure, kitchen with linen curtains", "fallback_title": "The Springer Mum." } },
        { "type": "product", "settings": { "eyebrow": "Apparel · Crewnecks", "tone": "tone-deep", "placeholder_caption": "BORN TO FLUSH · on-dog, covert at low light", "fallback_title": "Born to Flush." } },
        { "type": "product", "settings": { "eyebrow": "Accessories", "tone": "tone-seaglass", "placeholder_caption": "EMBROIDERED TOTE · the dog as model, leather handle detail", "fallback_title": "The Embroidered Tote." } }
      ]
    }
  ]
}
{% endschema %}
