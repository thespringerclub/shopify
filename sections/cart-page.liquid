{%- comment -%}
  Cart page — full-page cart, distinct from the cart drawer.
  Brief §11.6.
  Some users (and proxies) hit /cart directly; this needs to render even though the
  drawer is the primary surface.
{%- endcomment -%}

<section style="padding: 80px 0;">
  <div class="container-narrow">
    <p class="eyebrow text-muted text-center" style="margin-bottom: 16px;">In the bag</p>
    <h1 class="h1-page serif-italic text-center" style="margin-bottom: 56px;">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div style="border-top: 1px solid var(--ink);">
          {%- for line in cart.items -%}
            <div class="flex-between" style="padding: 24px 0; border-bottom: 1px solid var(--ink-12); align-items: flex-start; gap: 24px;">
              <div style="display: flex; gap: 24px; align-items: flex-start;">
                {%- if line.image != blank -%}
                  <a href="{{ line.url }}" style="display: block;">
                    {{ line.image | image_url: width: 240 | image_tag:
                        loading: 'lazy',
                        alt: line.product.title,
                        width: 96,
                        height: 120,
                        style: 'width: 96px; height: 120px; object-fit: cover;'
                    }}
                  </a>
                {%- endif -%}
                <div>
                  <a href="{{ line.url }}" class="serif-italic" style="font-size: 1.125rem; color: inherit;">{{ line.product.title }}</a>
                  {%- if line.variant.title != 'Default Title' -%}
                    <p class="micro" style="color: var(--ink-60); margin-top: 4px;">{{ line.variant.title | replace: ' / ', ' · ' }}</p>
                  {%- endif -%}
                  <p style="margin-top: 8px;">
                    <input type="number" name="updates[]" value="{{ line.quantity }}" min="0" style="width: 64px; padding: 6px 8px; border: 1px solid var(--ink); background: var(--bone); font-family: var(--sans); font-size: 0.875rem;">
                  </p>
                  <p style="margin-top: 8px;">
                    <a href="{{ line.url_to_remove }}" class="link" style="font-size: 0.8125rem;">{{ 'cart.remove' | t }}</a>
                  </p>
                </div>
              </div>
              <span class="body" style="font-size: 1rem;">{{ line.final_line_price | money_without_trailing_zeros }}</span>
            </div>
          {%- endfor -%}
        </div>

        <div style="display: flex; justify-content: space-between; gap: 24px; align-items: flex-end; margin-top: 32px; flex-wrap: wrap;">
          <div>
            <button type="submit" name="update" class="btn-secondary">Update bag.</button>
          </div>
          <div style="text-align: right;">
            <p class="serif-italic" style="font-size: 0.9375rem; color: var(--ink-60); margin-bottom: 12px;">
              {{ settings.cart_microcopy }}
            </p>
            <div class="flex-between" style="gap: 24px; align-items: baseline; margin-bottom: 18px;">
              <span class="serif-italic" style="font-size: 1.25rem;">{{ 'cart.subtotal' | t }}</span>
              <span class="body" style="font-size: 1.0625rem;">{{ cart.total_price | money_without_trailing_zeros }}</span>
            </div>
            <button type="submit" name="checkout" class="btn-primary">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="text-center" style="padding: 80px 0;">
        <p class="serif-italic" style="font-size: 1.5rem; margin-bottom: 24px;">{{ settings.cart_empty_message }}</p>
        <a href="{{ routes.collections_url }}" class="link-italic">The collection</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart page",
  "tag": "section",
  "settings": []
}
{% endschema %}
