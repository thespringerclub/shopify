{%- comment -%}
  Customer login. Brief §11.8.
  "Members in Good Standing." as page header. Two fields, one button.
{%- endcomment -%}

<section style="padding: 120px 0;">
  <div class="container-narrow" style="max-width: 480px;">
    <p class="eyebrow text-muted text-center" style="margin-bottom: 16px;">{{ section.settings.eyebrow | default: 'Account' }}</p>
    <h1 class="h1-page serif-italic text-center" style="margin-bottom: 48px;">{{ section.settings.heading | default: 'Members in Good Standing.' }}</h1>

    {%- form 'customer_login', novalidate: 'novalidate' -%}
      {%- if form.errors -%}
        <div class="field-error" style="margin-bottom: 24px; text-align: center;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <label class="label" for="customer_email">{{ 'customer.email' | t }}</label>
          <input class="input" type="email" name="customer[email]" id="customer_email" autocomplete="email" required>
        </div>
        <div>
          <label class="label" for="customer_password">{{ 'customer.password' | t }}</label>
          <input class="input" type="password" name="customer[password]" id="customer_password" autocomplete="current-password" required>
        </div>
        <button class="btn-primary" type="submit" style="margin-top: 12px;">{{ 'customer.sign_in' | t }}</button>
        <div class="text-center" style="margin-top: 12px; display: flex; justify-content: center; gap: 24px;">
          <a href="#recover" class="link" data-toggle="#recover-form">{{ 'customer.forgot_password' | t }}</a>
        </div>
        <div class="hairline-soft" style="margin: 12px 0;"></div>
        <p class="serif-italic text-center" style="font-size: 0.9375rem; color: var(--ink-60);">
          {{ 'customer.not_yet_on_rolls' | t }} <a href="{{ routes.account_register_url }}" class="link-italic">{{ 'customer.join_the_rolls' | t }}</a>
        </p>
      </div>
    {%- endform -%}

    {%- comment -%} Recover password form (hidden by default; toggled via anchor) {%- endcomment -%}
    <div id="recover-form" style="margin-top: 48px; padding-top: 32px; border-top: 1px solid var(--ink-12);">
      <p class="eyebrow text-muted text-center" style="margin-bottom: 16px;">Recovery</p>
      <h2 class="h3 text-center" style="margin-bottom: 32px;">{{ 'customer.reset_password' | t }}</h2>
      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <p class="serif-italic text-center" style="margin-bottom: 24px;">A recovery line has been sent.</p>
        {%- endif -%}
        <div style="display: flex; flex-direction: column; gap: 20px;">
          <div>
            <label class="label" for="recover_email">{{ 'customer.email' | t }}</label>
            <input class="input" type="email" name="email" id="recover_email" autocomplete="email" required>
          </div>
          <p class="serif-italic" style="font-size: 0.9375rem; color: var(--ink-60);">
            {{ 'customer.reset_subtitle' | t }}
          </p>
          <button class="btn-primary" type="submit">{{ 'customer.submit_recover' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Account" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Members in Good Standing." }
  ]
}
{% endschema %}
