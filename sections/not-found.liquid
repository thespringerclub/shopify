{%- comment -%}
  404 / off-trail. Brief §11.12.
  Editorial moment, never a "we're sorry" page.
{%- endcomment -%}

<section style="padding: 140px 0; text-align: center;">
  <div class="container-narrow">
    {%- if section.settings.illustration != blank -%}
      <div style="display: flex; justify-content: center; margin-bottom: 40px;">
        {{ section.settings.illustration | image_url: width: 400 | image_tag:
            alt: 'Illustration',
            style: 'width: 200px; height: auto;'
        }}
      </div>
    {%- else -%}
      <div style="margin-bottom: 40px; display: flex; justify-content: center;">
        {%- render 'mark-placeholder', label: section.settings.placeholder_label, width: 200, height: 200 -%}
      </div>
    {%- endif -%}

    <p class="eyebrow text-muted" style="margin-bottom: 18px;">{{ section.settings.eyebrow | default: '404' }}</p>
    <h1 class="h1-page serif-italic" style="margin-bottom: 24px;">{{ section.settings.heading | default: 'You appear to be off-trail.' }}</h1>
    <p class="serif-italic" style="font-size: 1.25rem; color: var(--ink-60); margin-bottom: 36px;">
      {{ section.settings.subtitle | default: 'This page is currently flushed.' }}
    </p>
    <a href="{{ section.settings.link | default: routes.collections_url }}" class="link-italic">
      {{- section.settings.link_label | default: 'Return to the collection.' -}}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Not found",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "illustration", "label": "Illustration (Bawden-style Springer)" },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "ILLUSTRATION · A SPRINGER OFF-TRAIL, SNIFFING THE AIR" },
    { "type": "text", "id": "eyebrow",    "label": "Eyebrow",    "default": "404" },
    { "type": "text", "id": "heading",    "label": "Heading",    "default": "You appear to be off-trail." },
    { "type": "text", "id": "subtitle",   "label": "Subtitle",   "default": "This page is currently flushed." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Return to the collection." },
    { "type": "url",  "id": "link",       "label": "Link" }
  ],
  "presets": [
    { "name": "Not found" }
  ]
}
{% endschema %}
