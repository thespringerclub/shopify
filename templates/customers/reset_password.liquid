{%- comment -%}
  Reset password (after clicking recovery link).
{%- endcomment -%}

<section style="padding: 120px 0;">
  <div class="container-narrow" style="max-width: 480px;">
    <p class="eyebrow text-muted text-center" style="margin-bottom: 16px;">Recovery</p>
    <h1 class="h1-page serif-italic text-center" style="margin-bottom: 16px;">{{ 'customer.reset_password' | t }}</h1>
    <p class="serif-italic text-center" style="font-size: 1.0625rem; color: var(--ink-60); margin-bottom: 48px;">
      A new password, set in confidence.
    </p>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="field-error" style="margin-bottom: 24px; text-align: center;">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div style="display: flex; flex-direction: column; gap: 20px;">
        <div>
          <label class="label" for="reset_password">New password</label>
          <input class="input" type="password" name="customer[password]" id="reset_password" required>
        </div>
        <div>
          <label class="label" for="reset_password_confirm">Confirm new password</label>
          <input class="input" type="password" name="customer[password_confirmation]" id="reset_password_confirm" required>
        </div>
        <button class="btn-primary" type="submit" style="margin-top: 12px;">Reset password.</button>
      </div>
    {%- endform -%}
  </div>
</section>
