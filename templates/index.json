        "body": {
          "type": "body",
          "settings": {
            "text": "<p>The Springer Club is a small house built around the English Springer Spaniel and the world that surrounds it — the country house, the sporting weekend, the hand-thatched fishing camp, the coastal cottage.</p>",
            "style": "editorial-body",
            "align": "center",
            "max_width": 58,
            "margin_bottom": 36
