<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_bone }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Inter:wght@400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet">

    <title>
      {{ page_title }}
      {%- if current_tags -%}{%- assign meta_tags = current_tags | join: ', ' -%} &mdash; {{ meta_tags }}{%- endif -%}
      {%- if current_page != 1 %} &mdash; Page {{ current_page }}{%- endif -%}
      {%- unless page_title contains shop.name %} &mdash; {{ shop.name }}{%- endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- liquid
      assign body_classes = 'template-' | append: template | replace: '.', '-' | handleize
      if request.page_type == 'index'
        assign body_classes = body_classes | append: ' is-home'
      endif
      if settings.header_transparent_on_home and request.page_type == 'index'
        assign body_classes = body_classes | append: ' header-transparent'
      endif
    -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --bone: {{ settings.color_bone }};
        --sage: {{ settings.color_sage }};
        --seaglass: {{ settings.color_seaglass }};
        --clay: {{ settings.color_clay }};
        --ink: {{ settings.color_ink }};
        --ink-60: rgba(44, 42, 40, 0.6);
        --ink-30: rgba(44, 42, 40, 0.3);
        --ink-12: rgba(44, 42, 40, 0.12);
        --ink-08: rgba(44, 42, 40, 0.08);
      }
    </style>

    <script>document.documentElement.classList.replace('no-js','js');</script>
  </head>

  <body class="{{ body_classes }}">
    <a href="#main" class="skip-link">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- section 'cart-drawer' -%}
    {%- render 'search-overlay' -%}
    {%- render 'toast' -%}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
